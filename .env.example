# ============================================================================
# ARCHLY.CLOUD — ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this file to .env.local and fill in your actual values.
# .env.local is never committed to git.
#
# Single source of truth for all services: frontend, collab, postgres.
# Used by: docker-compose.yml, Next.js apps/editor, Yjs services/collab
#
# ============================================================================

# ────────────────────────────────────────────────────────────────────────────
# DATABASE (PostgreSQL)
# ────────────────────────────────────────────────────────────────────────────
POSTGRES_USER=archly
POSTGRES_PASSWORD=change_me_secure_password
POSTGRES_DB=archly

# Prisma connection string (used by frontend + collab)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://archly:change_me_secure_password@postgres:5432/archly

# ────────────────────────────────────────────────────────────────────────────
# APP CONFIGURATION
# ────────────────────────────────────────────────────────────────────────────
NODE_ENV=development

# Reverse Proxy (Caddy)
# Development: Use archly.local (add to /etc/hosts or configure DNS)
# Production: Use your domain (Caddy auto-provisions HTTPS)
CADDY_DOMAIN=archly.local

# Frontend URLs (used by Next.js and browser)
# With Caddy: use same domain as CADDY_DOMAIN
# Without Caddy: use localhost:3002
NEXT_PUBLIC_APP_URL=http://archly.local
NEXT_PUBLIC_API_URL=http://archly.local/api
NEXT_PUBLIC_WS_URL=ws://archly.local/ws

# ────────────────────────────────────────────────────────────────────────────
# AUTHENTICATION (BetterAuth)
# ────────────────────────────────────────────────────────────────────────────
# Secret: generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your_secret_key_minimum_32_characters_long
# Use Caddy domain if Caddy enabled, localhost:3002 otherwise
BETTER_AUTH_URL=http://archly.local

# OAuth Providers (optional, for social login)
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_secret

GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_secret

# Email service (Resend)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=noreply@archly.cloud

# ────────────────────────────────────────────────────────────────────────────
# STORAGE & CDN (Cloudflare R2)
# ────────────────────────────────────────────────────────────────────────────
# Optional if not using file uploads yet.

R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET=archly-assets
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

# Public CDN URL for accessing uploaded assets
NEXT_PUBLIC_R2_PUBLIC_URL=https://cdn.archly.cloud
R2_PUBLIC_URL=https://cdn.archly.cloud

# Max upload size in bytes (100MB)
MAX_UPLOAD_SIZE=104857600

# ────────────────────────────────────────────────────────────────────────────
# COLLABORATION SERVER (Yjs WebSocket)
# ────────────────────────────────────────────────────────────────────────────
YJS_HOST=0.0.0.0
YJS_PORT=1234
YJS_LOG_LEVEL=info
YJS_PERSISTENCE_ENABLED=true
YJS_PERSISTENCE_DB_URL=postgresql://archly:change_me_secure_password@postgres:5432/archly
YJS_SNAPSHOT_INTERVAL=3600000
YJS_DOC_RETENTION_DAYS=90
YJS_MAX_CLIENTS_PER_DOC=100

# ────────────────────────────────────────────────────────────────────────────
# LOGGING
# ────────────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FORMAT=json

# ────────────────────────────────────────────────────────────────────────────
# FEATURE FLAGS
# ────────────────────────────────────────────────────────────────────────────
FEATURE_MARKETPLACE_ENABLED=true
FEATURE_CLONE_DUPLICATION=true
FEATURE_REAL_TIME_SYNC=true
FEATURE_PRESENCE_CURSORS=true
FEATURE_SPATIAL_COMMENTS=false
