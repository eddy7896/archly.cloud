# ============================================================================
# UNIFIED ENVIRONMENT FILE — archly.cloud
# ============================================================================
# Single source of truth for all services: frontend, collab, database.
# Copy to .env.local and fill in actual values.
#
# Structure:
#  1. Database (PostgreSQL)
#  2. Frontend (Next.js)
#  3. Authentication
#  4. External APIs & Services
#  5. Storage & CDN (Cloudflare R2)
#  6. Collaboration Server (Yjs)
#  7. Logging & Monitoring
#  8. Feature Flags
# ============================================================================

# ────────────────────────────────────────────────────────────────────────────
# 1. DATABASE (PostgreSQL)
# ────────────────────────────────────────────────────────────────────────────
POSTGRES_USER=archly
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=archly
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Prisma connection string (docker-compose: postgres service)
DATABASE_URL=postgresql://archly:your_secure_password_here@postgres:5432/archly

# Direct JDBC-style (if using other tools)
DATABASE_JDBC_URL=jdbc:postgresql://postgres:5432/archly

# ────────────────────────────────────────────────────────────────────────────
# 2. FRONTEND (Next.js, apps/editor on port 3002)
# ────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3002
NEXT_PUBLIC_API_URL=http://localhost:3002/api
NEXT_PUBLIC_WS_URL=ws://localhost:1234
NODE_ENV=development

# ────────────────────────────────────────────────────────────────────────────
# 3. AUTHENTICATION (BetterAuth)
# ────────────────────────────────────────────────────────────────────────────
BETTER_AUTH_SECRET=your_secret_key_here_min_32_chars
BETTER_AUTH_URL=http://localhost:3002

# OAuth — Google
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# OAuth — GitHub
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Email Service (Resend)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=noreply@archly.cloud

# ────────────────────────────────────────────────────────────────────────────
# 4. EXTERNAL SERVICES
# ────────────────────────────────────────────────────────────────────────────

# Google Maps (optional, for address search in UI)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Supabase (if using for auth/real-time, optional)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ────────────────────────────────────────────────────────────────────────────
# 5. STORAGE & CDN (Cloudflare R2)
# ────────────────────────────────────────────────────────────────────────────

# R2 Endpoint (S3-compatible API)
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET=archly-assets

# R2 Credentials
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key

# Public CDN URL (CORS-enabled, for client-side asset loading)
NEXT_PUBLIC_R2_PUBLIC_URL=https://cdn.archly.cloud
R2_PUBLIC_URL=https://cdn.archly.cloud

# Max file upload size (bytes)
MAX_UPLOAD_SIZE=104857600  # 100MB

# ────────────────────────────────────────────────────────────────────────────
# 6. COLLABORATION SERVER (Yjs WebSocket, port 1234)
# ────────────────────────────────────────────────────────────────────────────

# Yjs server configuration
YJS_HOST=0.0.0.0
YJS_PORT=1234
YJS_LOG_LEVEL=info

# Persistence
YJS_PERSISTENCE_ENABLED=true
YJS_PERSISTENCE_DB_URL=postgresql://archly:your_secure_password_here@postgres:5432/archly
YJS_SNAPSHOT_INTERVAL=3600000  # 1 hour in ms

# Document cleanup (delete inactive docs after N days)
YJS_DOC_RETENTION_DAYS=90

# Max concurrent connections per document
YJS_MAX_CLIENTS_PER_DOC=100

# ────────────────────────────────────────────────────────────────────────────
# 7. LOGGING & MONITORING
# ────────────────────────────────────────────────────────────────────────────

LOG_LEVEL=info  # debug, info, warn, error
LOG_FORMAT=json  # json or text

# OpenTelemetry (optional)
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Sentry (optional, for error tracking)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# ────────────────────────────────────────────────────────────────────────────
# 8. FEATURE FLAGS
# ────────────────────────────────────────────────────────────────────────────

# Marketplace
FEATURE_MARKETPLACE_ENABLED=true
FEATURE_CLONE_DUPLICATION=true

# Collaboration
FEATURE_REAL_TIME_SYNC=true
FEATURE_PRESENCE_CURSORS=true
FEATURE_SPATIAL_COMMENTS=false

# Performance
FEATURE_LAZY_LOAD_ASSETS=true
FEATURE_VIEWPORT_CULLING=true

# ────────────────────────────────────────────────────────────────────────────
# 9. DEVELOPMENT OVERRIDES (local.env only, never in git)
# ────────────────────────────────────────────────────────────────────────────

# Skip email validation for local testing
SKIP_EMAIL_VALIDATION=false

# Enable Next.js API debugging
DEBUG=
