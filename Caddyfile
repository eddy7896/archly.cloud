# ============================================================================
# CADDY REVERSE PROXY CONFIGURATION — archly.cloud
# ============================================================================
# Routes all traffic to internal services:
#  - frontend (Next.js) → :3002
#  - collab (Yjs WebSocket) → :1234
#
# Usage:
#   - Development: http://archly.local (configure hosts file or use DNS)
#   - Production: https://archly.cloud (auto HTTPS via Let's Encrypt)
#
# ============================================================================

# ────────────────────────────────────────────────────────────────────────────
# STAGING / DEVELOPMENT
# ────────────────────────────────────────────────────────────────────────────
{$DOMAIN}:80 {
  # API endpoints → frontend
  reverse_proxy /api/* frontend:3002

  # WebSocket for collaboration → collab server
  reverse_proxy /ws http://collab:1234 {
    header_up Connection "upgrade"
    header_up Upgrade "websocket"
  }

  # Alternative WebSocket endpoint (if needed)
  reverse_proxy /collaborate http://collab:1234 {
    header_up Connection "upgrade"
    header_up Upgrade "websocket"
  }

  # Static assets and SPA → frontend
  reverse_proxy /* frontend:3002 {
    # Caddy handles X-Forwarded-For/Proto by default
    header_up X-Real-IP {remote_host}
  }

  # Security headers
  header X-Content-Type-Options nosniff
  header X-Frame-Options SAMEORIGIN
  header X-XSS-Protection "1; mode=block"
  header Referrer-Policy strict-origin-when-cross-origin

  # Logging
  log {
    output stdout
    format json
  }

  # Rate limiting (optional, tuned for dev)
  # rate_limit / 100r/s
}

# ────────────────────────────────────────────────────────────────────────────
# PRODUCTION (uncomment and customize)
# ────────────────────────────────────────────────────────────────────────────
