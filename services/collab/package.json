{
  "name": "archly-collab",
  "version": "0.1.0",
  "description": "Yjs WebSocket collaboration server for archly.cloud",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --exec node --loader tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.18.2",
    "ws": "^8.16.0",
    "yjs": "^13.6.8",
    "y-websocket": "^1.5.0",
    "y-protocols": "^1.0.6",
    "y-indexeddb": "^9.0.12",
    "lib0": "^0.2.97",
    "pg": "^8.11.3",
    "dotenv": "^16.3.1",
    "uuid": "^9.0.1",
    "pino": "^8.17.2",
    "pino-http": "^8.6.1"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "^20.11.0",
    "@types/express": "^4.17.21",
    "@types/ws": "^8.5.9",
    "nodemon": "^3.0.3",
    "tsx": "^4.7.0",
    "eslint": "^8.56.0"
  },
  "engines": {
    "node": ">=18"
  }
}
